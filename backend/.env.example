# WhatsApp Cloud API Credentials
# Obtenha em: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started

# Seu Business Account ID (número longo)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# Phone Number ID (ID do número comercial registrado)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Token de acesso (Access Token com permissão whatsapp_business_messaging)
WHATSAPP_ACCESS_TOKEN=your_access_token

# Token de segurança para validar webhook (crie um valor seguro)
WEBHOOK_TOKEN=seu_webhook_token_secreto_aqui

# Porta do servidor
PORT=3001
